    "cleanup:drafts:dry-run": "tsx scripts/cleanup-draft-uploads.ts --dry-run"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "nanoid": "^5.0.7",
