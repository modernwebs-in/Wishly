# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/wishly?schema=public"

# --- Auth ---
# Random string, 32+ characters. Generate with: openssl rand -base64 32
# NEVER commit the real value. Rotating this invalidates every existing
# session immediately (all tokens fail signature verification).
AUTH_SECRET=""

# --- Storage: public (birthday photos, custom music, QR codes, drafts) ---
# Served directly, same-origin, at /uploads/... under the local provider.
LOCAL_UPLOAD_DIR="./public/uploads"

# --- Storage: private (payment screenshots — NEVER served from a public
# path; only reachable through the admin-authenticated screenshot route) ---
LOCAL_PRIVATE_UPLOAD_DIR="./private-uploads"

# --- Storage provider selection ---
# "local" (default) stores both public and private files on disk, as
# above. Set to "s3" once the S3-compatible provider in lib/storage.ts is
# uncommented and wired up — that is NOT done automatically by setting
# this value; the code change is still required.
STORAGE_PROVIDER="local"

# --- S3-compatible storage (only used once STORAGE_PROVIDER=s3 AND the S3
# provider in lib/storage.ts has been uncommented) ---
STORAGE_URL=""
STORAGE_KEY=""
STORAGE_SECRET=""
STORAGE_REGION=""
# Separate buckets for public vs private — the private bucket must NOT
# have a public-read bucket policy. This is what makes payment screenshots
# actually private in production; local dev's equivalent guarantee is
# LOCAL_PRIVATE_UPLOAD_DIR living outside ./public.
STORAGE_PUBLIC_BUCKET=""
STORAGE_PRIVATE_BUCKET=""
STORAGE_PUBLIC_BASE_URL=""

# --- Draft upload cleanup job (scripts/cleanup-draft-uploads.ts) ---
# Hours after which an unattached wizard-draft photo/music upload is
# considered abandoned and safe to delete. Files still referenced by a
# Surprise/SurprisePhoto row are never deleted regardless of age.
UPLOAD_CLEANUP_AFTER_HOURS=24

# --- Rate limiting (all optional — sane defaults apply if unset; see
# lib/rate-limit.ts for exact windows) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_RESET_PASSWORD_MAX=10
RATE_LIMIT_PAYMENT_SUBMIT_MAX=5
RATE_LIMIT_UPLOAD_MAX=40
RATE_LIMIT_PUBLIC_SURPRISE_MAX=60

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
